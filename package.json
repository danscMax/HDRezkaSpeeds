{
  "name": "hdrezka-speeds",
  "version": "0.7.3",
  "description": "HDRezka Speed Controller — speed buttons, slider, hotkeys, diagnostics. Bilingual (EN/RU).",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "build:userscript": "vite build --config vite.userscript.config.ts",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "drift": "node scripts/check-drift.mjs",
    "postinstall": "wxt prepare",
    "test:smoke:fullscreen": "node tests/smoke/fullscreen-no-ui.mjs",
    "test:smoke:dim": "node tests/smoke/dim-other-screens.mjs",
    "submit": "node scripts/submit.mjs",
    "submit:check": "node scripts/submit.mjs --dry-run",
    "submit:status": "publish-extension status --chrome-api-version v2",
    "listing:check": "node scripts/push-amo-listing.mjs --check",
    "listing:push": "node scripts/push-amo-listing.mjs",
    "test:smoke:first-run": "node tests/smoke/first-run-hint.mjs",
    "listing:paste": "node scripts/push-amo-listing.mjs --paste ../plans/promotion/cws-paste"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.5",
    "happy-dom": "^20.10.2",
    "publish-browser-extension": "^6.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vite-plugin-monkey": "^8.0.4",
    "vitest": "^4.1.5",
    "web-ext": "^10.3.0",
    "wxt": "^0.20.26"
  }
}
